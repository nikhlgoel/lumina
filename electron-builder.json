{
  "appId": "com.lumina.media",
  "productName": "Lumina",
  "copyright": "Copyright © 2026 Lumina",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron",
    "package.json",
    "!node_modules/**",
    "node_modules/@lydell/**",
    "!**/*.map"
  ],
  "//asarUnpack": "node-pty's prebuilt .node binaries cannot be loaded from inside an asar archive.",
  "asarUnpack": ["node_modules/@lydell/**"],
  "extraResources": [
    { "from": "resources/bin/${platform}-${arch}", "to": "bin", "filter": ["**/*"] },
    { "from": "resources/models", "to": "models", "filter": ["**/*"] },
    { "from": "assets/icons", "to": "icons", "filter": ["*.png", "*.ico"] },
    { "from": "extension", "to": "extension", "filter": ["**/*"] }
  ],
  "protocols": [
    { "name": "Magnet link", "schemes": ["magnet"] },
    { "name": "Lumina", "schemes": ["lumina"] }
  ],
  "fileAssociations": [
    { "ext": "torrent", "name": "BitTorrent file", "description": "Torrent file", "role": "Viewer", "icon": "assets/icons/icon.ico" }
  ],
  "linux": {
    "target": ["AppImage", "rpm"],
    "category": "AudioVideo",
    "icon": "build/icons",
    "synopsis": "Download anything, play it beautifully",
    "executableName": "lumina",
    "desktop": {
      "entry": {
        "Name": "Lumina",
        "GenericName": "Media Downloader and Player",
        "Comment": "Download and play music and video",
        "Categories": "AudioVideo;Audio;Video;Network;FileTransfer;",
        "Keywords": "download;youtube;music;video;torrent;player;",
        "StartupWMClass": "lumina-media",
        "MimeType": "application/x-bittorrent;x-scheme-handler/magnet;x-scheme-handler/lumina;"
      }
    }
  },
  "rpm": {
    "fpm": ["--rpm-rpmbuild-define", "_build_id_links none"]
  },
  "appImage": {
    "artifactName": "Lumina-${version}-${arch}.AppImage"
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/icons/icon.ico",
    "legalTrademarks": "Lumina",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lumina",
    "installerIcon": "assets/icons/icon.ico",
    "uninstallerIcon": "assets/icons/icon.ico",
    "installerHeaderIcon": "assets/icons/icon.ico",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/installerSidebar.bmp",
    "installerHeader": "build/installerHeader.bmp",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "Lumina-Setup-${version}-windows-x64.exe"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "assets/icons/icon_1024.png",
    "category": "public.app-category.music"
  }
}
