{
  "name": "lumina-media",
  "version": "3.0.0-alpha.0",
  "description": "Lumina - media downloader and player",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "nikhlgoel",
    "email": "nikhlgoel@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tools:fetch": "node scripts/fetch-tools.mjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm tools:fetch --platform win32 && pnpm build && electron-builder --win nsis",
    "package:linux": "pnpm tools:fetch --platform linux && pnpm build && electron-builder --linux AppImage rpm"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "monaco-editor": "^0.56.0",
    "music-metadata": "^11.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.1"
  }
}
